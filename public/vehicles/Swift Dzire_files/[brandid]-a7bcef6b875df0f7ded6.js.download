In recent times, AMD Ryzen 5, AMD Ryzen 7 and AMD Ryzen 9 processors have started gaining popularity in the gaming industry due to higher performance output at competitive prices. "),w("div",{className:"jsx-2312161285 font15 fw500 color111 mt-20"},"Processor in the Market Today"),w("div",{className:"jsx-2312161285 laptop_brandlogo_wpr mt-30"},w("div",{className:"jsx-2312161285 laptop_brandlogo_content"},w("div",{className:"jsx-2312161285 brandlogo_img"},w("img",{src:"https://akam.cdn.jdmagicbox.com/images/icontent/hyperlocal/inteli5_logo.png",className:"jsx-2312161285"})),w("div",{className:"jsx-2312161285 font20 fw500 color111 mt-15"},"Intel i5 "),w("div",{className:"jsx-2312161285 font14 color555 mt-5"},"(Latest generation)")),w("div",{className:"jsx-2312161285 laptop_brandlogo_content"},w("div",{className:"jsx-2312161285 brandlogo_img"},w("img",{src:"https://akam.cdn.jdmagicbox.com/images/icontent/hyperlocal/AMDRyzen_logo.png",className:"jsx-2312161285"})),w("div",{className:"jsx-2312161285 font20 fw500 color111 mt-15"},"AMD Ryzen 5"),w("div",{className:"jsx-2312161285 font14 color555 mt-5"},"(Latest generation)")),w("div",{className:"jsx-2312161285 laptop_brandlogo_content"},w("div",{className:"jsx-2312161285 brandlogo_img"},w("img",{src:"https://akam.cdn.jdmagicbox.com/images/icontent/hyperlocal/inteli7_logo.png",className:"jsx-2312161285"})),w("div",{className:"jsx-2312161285 font20 fw500 color111 mt-15"},"Intel i7 "),w("div",{className:"jsx-2312161285 font14 color555 mt-5"},"(Latest generation)")),w("div",{className:"jsx-2312161285 laptop_brandlogo_content"},w("div",{className:"jsx-2312161285 brandlogo_img"},w("img",{src:"https://akam.cdn.jdmagicbox.com/images/icontent/hyperlocal/AMDRyzen_logo.png",className:"jsx-2312161285"})),w("div",{className:"jsx-2312161285 font20 fw500 color111 mt-15"},"AMD Ryzen 7"),w("div",{className:"jsx-2312161285 font14 color555 mt-5"},"(Latest generation)")),w("div",{className:"jsx-2312161285 laptop_brandlogo_content"},w("div",{className:"jsx-2312161285 brandlogo_img"},w("img",{src:"https://akam.cdn.jdmagicbox.com/images/icontent/hyperlocal/inteli9_logo.png",className:"jsx-2312161285"})),w("div",{className:"jsx-2312161285 font20 fw500 color111 mt-15"},"Intel i9"),w("div",{className:"jsx-2312161285 font14 color555 mt-5"},"(Latest generation)")),w("div",{className:"jsx-2312161285 laptop_brandlogo_content"},w("div",{className:"jsx-2312161285 brandlogo_img"},w("img",{src:"https://akam.cdn.jdmagicbox.com/images/icontent/hyperlocal/AMDRyzen_logo.png",className:"jsx-2312161285"})),w("div",{className:"jsx-2312161285 font20 fw500 color111 mt-15"},"AMD Ryzen 9"),w("div",{className:"jsx-2312161285 font14 color555 mt-5"},"(Latest generation)"))),w("div",{className:"jsx-2312161285 font20 color111 fw500 mob_font15 mt-40"},"GPU or a Graphics processing unit"),w("div",{className:"jsx-2312161285 font14 color111 fw400 mt-12 "},"A GPU is a processor purposefully fit in a laptop to accelerate graphics production and video rendering, which is important for gaming. They can either be integrated with your CPU or be a dedicated unit. A dedicated GPU is highly recommended for gaming laptops."),w("div",{className:"jsx-2312161285 font15 fw500 color111 mt-25"},"GPUs in the market today:"),w("div",{className:"jsx-2312161285 gaminglaptop_chart mt-20"},w("div",{className:"jsx-2312161285 gaminglaptop_outer"},w("div",{className:"jsx-2312161285 font15 color111 col-1"},"Intel Iris Plus"),w("div",{className:"jsx-2312161285 font15 color111 col-2"},"Nvidia Geforce GTX 1660ti")),w("div",{className:"jsx-2312161285 gaminglaptop_outer"},w("div",{className:"jsx-2312161285 font15 color111 col-1"},"Intel Iris X"),w("div",{className:"jsx-2312161285 font15 color111 col-2"},"Nvidia Geforce GTX 1080")),w("div",{className:"jsx-2312161285 gaminglaptop_outer"},w("div",{className:"jsx-2312161285 font15 color111 col-1"},"Intel ARC"),w("div",{className:"jsx-2312161285 font15 color111 col-2"},"Nvidia Geforce GTX 1080ti")),w("div",{className:"jsx-2312161285 gaminglaptop_outer"},w("div",{className:"jsx-2312161285 font15 color111 col-1"},"Nvidia Geforce GTX 1650"),w("div",{className:"jsx-2312161285 font15 color111 col-2"},"Nvidia Geforce RTX 2060")),w("div",{className:"jsx-2312161285 gaminglaptop_outer"},w("div",{className:"jsx-2312161285 font15 color111 col-1"},"Nvidia Geforce GTX 1650ti"),w("div",{className:"jsx-2312161285 font15 color111 col-2"},"Nvidia Geforce RTX 2070")),w("div",{className:"jsx-2312161285 gaminglaptop_outer"},w("div",{className:"jsx-2312161285 font15 color111 col-1"},"Nvidia Geforce GTX 1660"),w("div",{className:"jsx-2312161285 font15 color111 col-2"},"Nvidia Geforce RTX 2080"))),w("div",{className:"jsx-2312161285 laptop_dtl_wpr mt-40"},w("div",{className:"jsx-2312161285 laptop_dtl_outer"},w("div",{className:"jsx-2312161285 font20 fw500 color111"},"RAM or Random Access Memory"),w("div",{className:"jsx-2312161285 laptop_dtl_img mt-20"},w("img",{src:"https://akam.cdn.jdmagicbox.com/images/icontent/hyperlocal/banner2_img.png",className:"jsx-2312161285"})),w("div",{className:"jsx-2312161285 mt-15 color111 font14"},"RAM helps the laptop write and process temporary data faster, it is a tool widely used for multitasking. RAM ranges from 8GB to 32GB in gaming laptops. 8GB is usually sufficient but if want something a bit quicker, 16GB should do. ")),w("div",{className:"jsx-2312161285 laptop_dtl_outer"},w("div",{className:"jsx-2312161285 font20 fw500 color111"},"Storage"),w("div",{className:"jsx-2312161285 laptop_dtl_img mt-20"},w("img",{src:"https://akam.cdn.jdmagicbox.com/images/icontent/hyperlocal/banner3_img.png",className:"jsx-2312161285"})),w("div",{className:"jsx-2312161285 mt-15 color111 font14"},"Storage comes in 3 types, a Solid State Drive (SSD), a Hard Disk Drive (HDD) and a mix of both SSD and HDD. Usually, a 512GB SSD is enough for gaming but if you want to up the ante a 1TB SSD will be perfect. A mix of both is excellent as the files of games can be saved onto a smaller SSD of 256GB or 512GB and the larger files from everyday use can be written onto the HDD of either 500GB or 1TB, giving you divided space between the two.")),w("div",{className:"jsx-2312161285 laptop_dtl_outer"},w("div",{className:"jsx-2312161285 font20 fw500 color111"},"RAM or Random Access Memory"),w("div",{className:"jsx-2312161285 laptop_dtl_img mt-20"},w("img",{src:"https://akam.cdn.jdmagicbox.com/images/icontent/hyperlocal/banner4_img.png",className:"jsx-2312161285"})),w("div",{className:"jsx-2312161285 mt-15 color111 font14"},"Gaming laptops have high-performance parts such as the GPU, CPU, and high-speed fans that drain the battery a lot faster than normal laptops. Look for gaming laptops with bigger battery and support quick charging to ensure you have the flexibility of gaming from anywhere without having your laptop constantly plugged-in to a power source. Battery sizes range from 4000 mAH to 10000 mAH."))))))))))},j=o.a.createElement;var k=function(e){return j(o.a.Fragment,null,j(s.a,{id:"720528839"},['@charset "utf-8";',".hl_container{max-width:1580px;width:100%;margin:0 auto;}",".container_inrwrp{background:#fff;display:table;width:100%;table-layout:fixed;}",".dividerf2{border-bottom:1px solid #f2f2f2;height:1px;width:100%;}",".mt-12{margin-top:12px;}",".mt-8{margin-top:8px;}",".ml-75{margin-left:75px;}",".lh22{line-height:22px;}",".lh24{line-height:24px;}",".buyerguide_wrp{max-width:1000px;margin:0 auto;}",".buyerguide_wrp .displaydesc_wrp .displaydesc_bx{width:33%;display:inline-block;margin-bottom:40px;padding-right:60px;vertical-align:top;}",".buyerguide_wrp .displaydesc_wrp .displaydesc_bx:nth-child(3n){margin-right:0;}",".buyerguide_wrp .displaydesc_wrp .displaydesc_bx .img_wrp{width:100%;margin-bottom:4px;}",".buyerguide_wrp .displaydesc_wrp .displaydesc_bx .img_wrp .img_bx{display:inline-block;width:90px;height:114px;border-radius:90px;}",".buyerguide_wrp .displaydesc_wrp .displaydesc_bx .img_wrp .img_bx img{width:100%;}",".buyerguide_wrp .displaydesc_wrp 
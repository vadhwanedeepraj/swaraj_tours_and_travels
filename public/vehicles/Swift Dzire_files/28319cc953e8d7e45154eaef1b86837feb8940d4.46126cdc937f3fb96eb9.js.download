ck tracker Name","7- description","8- images"],data:[["1","B2B","https://www.justdial.com/jdmart","B2B Marketplace","Experience the ultimate B2B portal by Justdial. You can explore countless diverse categories, innumerable top-quality vendors, and an unmatched wholesale experience. You'll find everything you need for B2B requirements on this exclusive platform. Our interactive interface allows you to apply relevant filters, ascertain the best rates, and get instant assistance via chat.","/ftr_b2b.svg"],["2","All India","https://www.justdial.com/india","All India","Elevate your search for B2B requisites. From lead generation to promoting and selling products/services, Justdial enables enterprises to reach vast audiences all across India. Embracing digital strategies, Justdial India encompasses manufacturers, dealers, suppliers, vendors, wholesalers, and more, offering convenience in the B2B market space and empowering businesses nationwide.","/ftr_allindia.svg"],["3","Packers and Movers","https://www.justdial.com/"+D+"/Packers-And-Movers"+q+"/nct-10348289","Packers and Movers","If you\u2019re relocating to another place, or even if you just want to send some belongings elsewhere, find the best deals on the most reliable packers and movers for your location. Get quotes from multiple agencies, read reviews from previous customers, and check ratings before making a selection for a hassle-free experience.","/ftr_packersmovers.svg"],["4","Order Food Online","https://www.justdial.com/"+D+"/Order-Food-Online"+q+"/nct-10250324","Food Home Delivery","You are just three clicks away from placing an order and exploring a wide range of exotic cuisines. Order food online with Justdial and get your favourite food delivered at your doorstep. Search for restaurants, view reviews and ratings, avail discounts and order your food.","/ftr_orderfood.svg"],["5","Jobs","https://www.justdial.com/"+D+"/Jobs"+q+"/nct-10372869","Jobs & Vacancies","Providing pertinent jobs to job seekers and relevant profiles to employers, this service will help you reach out to employers and vice-versa across industry verticals, experience levels and geographies.","/ftr_jobs.svg"],["6","Movies","https://www.justdial.com/"+D+"/Movies","Book Movie Tickets Online","This gives you access to book tickets and keep updated with the latest movies. With the provision of a synopsis, cast, crew and trailer, you can make a better choice in the movie you would like to watch.","/ftr_movies.svg"],["7","Spa & Salon","https://www.justdial.com/"+D+"/Beauty-Spas"+q+"/nct-10042600","Spa & Salon appointment online","Skip the wait to get pampered at a spa or a salon. In a few clicks, 'Book an Appointment' online through Justdial before your next visit.","/ftr_spa-salon.svg"],["8","Repair & Services","https://www.justdial.com/"+D+"/Repair-Maintenance-Services"+q+"/nct-11316015","Repair & Services","Find the 'Best Deal', be it for repairing your air-conditioner, getting your car serviced or cleaning your water purifier and drive your utility problems away.","/ftr_repairservices.svg"],["9","Doctor Appointment","https://www.justdial.com/"+D+"/Doctors"+q+"/nct-10892680","Book Doctor appointment","Find the suitable medical specialist to take care of your health and well-being. Healthcare made easy.","/ftr_doctorappointment.svg"],["10","Real Estate Agents","https://www.justdial.com/"+D+"/Real-Estate-Agents"+q+"/nct-10192623","Real Estate Agents","Discover the power of our cohesive platform for simplified property searches. Whether your interest lies in PG, rentals, buying, or selling, you can connect with trusted agents and developers and stay updated on upcoming or trending residential and commercial projects.","/ftr_realestateagent.svg"],["11","Online Recharge/Bill Payment","https://www.justdial.com/online-bill-payment","Online Mobile Bill Payment and Recharge","With the help of this service you can stay on track in making your bill payments and recharges without having to wait in a queue. This includes bill payments for gas, electricity, data card, DTH, landline, etc.","/ftr_onlinerecharge.svg"]]},te=function(e){var t=arguments.length>1&&void 0!==arguments[1]?arguments[1]:{},o=t.preventUpdate,i=void 0!==o&&o;!e.li||"hmpge"!==e.ll&&"dtlpg"!==e.ll&&"rsltpge"!==e.ll||1==i||(e.gTag={event:"menu_click",menu_position:"Web footer",menu_header:"",menu_name:e.li,sub_menu_name:""})},oe=Object(r.useMemo)((function(){try{var e,t,o,i=null===Y||void 0===Y||null===(e=Y[z])||void 0===e||null===(t=e.data)||void 0===t?void 0:t.find((function(e){return"POP_CAT_NEW"===e.type}));return null===i||void 0===i||null===(o=i.header_data)||void 0===o?void 0:o.reduce((function(e,t){return e[t]=i.data[t],e}),{})}catch(a){console.log(a)}}),[Y]);return b(l.a.Fragment,null,b("footer",{className:"jsx-743827983 jdwrapper jdfooter pt-20"},b("div",{className:"jsx-743827983 jdcontainer"},b("div",{className:"jsx-743827983 footer_rowbox footer_row_4 footer_social pt-40 pl-45 pr-45 pb-40"},b("h2",{className:"jsx-743827983 font18 fw500 color333"},"Follow us on "),b("ul",{className:"jsx-743827983 social_left"},b("li",{className:"jsx-743827983"},b("a",{target:"_blank",rel:"nofollow noreferrer",href:"https://www.facebook.com/JustDial",title:"Justdial on Facebook",onClick:function(){return te({li:"web_footer_FB",ll:"home"==(null===e||void 0===e?void 0:e.page)?"hmpge":null===e||void 0===e?void 0:e.page,navigation:"1",lpageval:"home"==(null===e||void 0===e?void 0:e.page)?"hmpge":null===e||void 0===e?void 0:e.page,contracts:[],search_id:"",ncatid:""})},className:"jsx-743827983 flw_facebook ml-20 pointer"})),b("li",{className:"jsx-743827983"},b("a",{target:"_blank",rel:"nofollow noreferrer",href:"https://www.youtube.com/user/justdialind",title:"Justdial on Youtube",onClick:function(){return te({li:"web_footer_youtube",ll:"home"==(null===e||void 0===e?void 0:e.page)?"hmpge":null===e||void 0===e?void 0:e.page,navigation:"1",lpageval:"home"==(null===e||void 0===e?void 0:e.page)?"hmpge":null===e||void 0===e?voi